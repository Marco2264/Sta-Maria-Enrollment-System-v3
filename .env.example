# ImageKit Configuration (Profile Photos, Banners & Announcement Images)
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional: Backend Authentication Signature Endpoint
# VITE_IMAGEKIT_AUTH_ENDPOINT=https://your-domain.com/api/imagekit-auth

# Private Key (For server-side authentication ONLY - NEVER include in frontend client build)
# IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
